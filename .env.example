# GEMINI_API_KEY: Required on the server for multimodal civic issue analysis and weekly summaries.
# Set this in AI Studio Secrets or Vercel Environment Variables (never expose to browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Optional public browser key for interactive Community Map.
# When omitted, RaastaAI automatically provides a structured list and coordinate fallback view.
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: Hosted URL of the application.
APP_URL="http://localhost:3000"
